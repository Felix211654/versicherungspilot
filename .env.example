# ---------- Pflicht ----------
# PostgreSQL 16+ mit den Extensions "vector" (pgvector) und "pg_trgm"
DATABASE_URL=postgres://vp:vp_dev_pw@localhost:5432/versicherungspilot
# Mind. 32 Zeichen, zufällig:  openssl rand -base64 48
BETTER_AUTH_SECRET=
# Öffentliche Basis-URL der App (Cookies, Redirects)
BETTER_AUTH_URL=http://localhost:3000
# 32 Byte base64 – Master-Key für die Dateiverschlüsselung:  openssl rand -base64 32
# ACHTUNG: Verlust = Dateien nicht mehr lesbar. Getrennt vom Datenbank-Backup sichern.
FILE_ENCRYPTION_KEY=
# HMAC-Schlüssel für kurzlebige Download-Links:  openssl rand -base64 48
DOWNLOAD_SIGNING_SECRET=

# ---------- Dateiablage ----------
STORAGE_DRIVER=local            # local | s3
STORAGE_LOCAL_DIR=./.data/storage
# S3-kompatibel (AWS, Hetzner, IONOS, MinIO …) – Dateien sind zusätzlich app-seitig verschlüsselt
S3_BUCKET=
S3_REGION=eu-central-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ---------- KI (optional) ----------
AI_PROVIDER=none                # none | anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5        # z. B. claude-sonnet-5-5 / claude-haiku-5-5 für geringere Kosten
EMBEDDING_PROVIDER=none         # none | voyage
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5

# ---------- Sicherheit / Verarbeitung (optional) ----------
CLAMAV_HOST=                    # clamd-Host für Virenscan; leer = "nicht geprüft"
CLAMAV_PORT=3310
OCR_LANGUAGES=deu+eng
MAX_UPLOAD_MB=25
TMP_DIR=                        # Verzeichnis für kurzlebige Klartext-Dateien (am besten tmpfs)
AUTH_RATE_LIMIT=                # "on" aktiviert Auth-Rate-Limits auch außerhalb von production
